# Stripe API keys — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — transactional email for contact form and newsletter signups
# Get a key at https://resend.com — free tier is 100 emails/day
RESEND_API_KEY=re_...

# Tracking pixels (optional — only loaded after cookie consent)
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
# Optional. v23.0 is a stable supported Graph API version.
META_GRAPH_API_VERSION=v23.0
# Optional. Only set temporarily while testing in Meta Events Manager.
META_TEST_EVENT_CODE=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=

# Search engine ownership verification (content value from each platform)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
